@startuml KVS C++ static view

package "score::mw::per::kvs" {
    +class KvsBuilder {
        +KvsBuilder(instance_id : InstanceId)
        +need_defaults_flag(flag : OpenNeedDefaults) : KvsBuilder
        +need_kvs_flag(flag : OpenNeedKvs) : KvsBuilder
        +dir(dir_path : string) : KvsBuilder
        +build() : Result<Kvs>
    }

    +class Kvs {
        -kvs_mutex : mutex
        -kvs : KeyValueMap
        -default_values : KeyValueMap
        -filename_prefix : Path
        -filesystem : Filesystem
        -parser : IJsonParser
        -writer : IJsonWriter
        -logger : Logger
        +reset()
        +get_all_keys() : vector<string>
        +key_exists(key : string) : bool
        +get_value(key : string) : KvsValue
        +get_default_value(key : string) : KvsValue
        +reset_key(key : string)
        +is_value_default(key : string) : bool
        +set_value(key : string, value : KvsValue)
        +remove_key(key : string)
        +remove_all_keys()
        +discard_pending_changes()
        +flush()
        +snapshot_count() : size_t
        +snapshot_max_count() : size_t
        +snapshot_restore(snapshot_id : SnapshotId)
        +get_storage_file_size() : size_t
    }

    +class KvsValue {
        +getType() : Type
        +getValue() : variant
    }

    enum ErrorCode
    class KvsErrorDomain

    class kvs_helper <<functions>> {
        ~calculate_hash_adler32(data : string) : uint32
        ~check_hash(data : string, hash : istream) : bool
        ~any_to_kvsvalue(any : json::Any) : KvsValue
        ~kvsvalue_to_any(value : KvsValue) : json::Any
    }

    KvsBuilder ..> Kvs : creates
    Kvs o-- KvsValue
    Kvs ..> kvs_helper : uses
    Kvs ..> ErrorCode : reports
    KvsErrorDomain ..> ErrorCode
}

package "score_baselibs" {
    interface "filesystem::Filesystem" as Filesystem
    interface "json::IJsonParser" as IJsonParser
    interface "json::IJsonWriter" as IJsonWriter
    interface "mw::log::Logger" as Logger
}

Kvs --> Filesystem
Kvs --> IJsonParser
Kvs --> IJsonWriter
Kvs --> Logger

@enduml
